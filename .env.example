# Panel Girisi (zorunlu): panele kullanici adi "admin", sifre bu degerle girilir
PANEL_TOKEN=buraya-uzun-rastgele-bir-sifre-yazin

# DeepSeek API anahtarınız (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# Sizin adiniz / asistanin nasil davranacagi
OWNER_NAME=Ali
ASSISTANT_STYLE=Samimi, kisa ve dogal Turkce yaz. Emojiyi nadiren kullan.

# Sunucuda veri klasoru (Render'da disk buraya baglanir)
DATA_DIR=/data

# Yerel Chrome'u zorla kullanmak isterseniz (opsiyonel)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Insan benzeri gecikme ayarlari (milisaniye)
REPLY_DELAY_MIN_MS=4000
REPLY_DELAY_MAX_MS=15000
TYPING_PER_CHAR_MS=35

# Acilista gecmis mesajlari oku (kapatirsaniz sadece yeni mesajlari gorur)
FETCH_HISTORY_ON_START=true
HISTORY_LIMIT_PER_CHAT=20
